<?xml version="1.0" encoding="utf-8"?>
<component type="desktop-application">
  <id>com.gabereglat.aoide.desktop</id>
  <name>Aoide</name>
  <summary>A Jellyfin music player with playlists and history that sync between your devices</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <content_rating type="oars-1.1"></content_rating>
  <description>
    <p>A music player for your own Jellyfin server, with playlists, smart playlists, mixes and listening history that sync with the Aoide app on iPhone.</p>
    <p>Features</p>
    <ul>
      <li>MPV player backend</li>
      <li>Web player backend</li>
      <li>Jellyfin server support</li>
      <li>Local playlists, smart playlists and mixes that sync between devices</li>
      <li>Listening history, Replay, and taste controls</li>
      <li>Modern UI</li>
      <li>Scrobble playback to your server</li>
      <li>Smart playlist editor</li>
      <li>Synchronized and unsynchronized lyrics support</li>
    </ul>
  </description>
  <developer id="org.jeffvli">
    <name>jeffvli</name>
  </developer>
